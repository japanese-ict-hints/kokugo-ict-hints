---
import type { Tip } from '../lib/tips';
import { HELPFUL } from '../lib/site';
import TipCard from './TipCard.astro';

interface Props {
  tips: Tip[];
  id?: string;
  searchable?: boolean;
  /** 2列までに抑えたいところで使う（関連事例など） */
  compact?: boolean;
  level?: 2 | 3 | 4;
}

const { tips, id = 'tip-list', searchable = false, compact = false, level = 3 } = Astro.props;
---

<ul class:list={['card-grid', compact && 'card-grid-compact']} id={id} data-count-url={HELPFUL.countUrl}>
  {
    tips.map((tip) => (
      <li>
        <TipCard tip={tip} searchable={searchable} level={level} />
      </li>
    ))
  }
</ul>

<script>
  // 事例カードに「役に立った」の数を出す。受け口に1回だけ聞いて、全部のカードに配る。
  // 数が0のものは何も出さない（0が並ぶと読みにくいため）。
  const grids = document.querySelectorAll<HTMLElement>('.card-grid[data-count-url]');
  const endpoint = grids[0]?.dataset.countUrl;
  if (endpoint) {
    fetch(endpoint + '/all')
      .then((r) => (r.ok ? r.json() : null))
      .then((counts: Record<string, number> | null) => {
        if (!counts) return;
        document.querySelectorAll<HTMLElement>('.card-helpful[data-slug]').forEach((el) => {
          const n = counts[el.dataset.slug ?? ''];
          if (!n) return;
          el.textContent = `👍 役に立った ${n}`;
          el.hidden = false;
        });
      })
      .catch(() => {});
  }
</script>
