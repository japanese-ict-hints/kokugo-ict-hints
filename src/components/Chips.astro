---
import { url } from '../lib/site';

interface Item {
  href: string;
  label: string;
  count?: number;
  current?: boolean;
}

interface Props {
  items: Item[];
  label: string;
  lead?: boolean;
}

const { items, label, lead = false } = Astro.props;
---

<nav aria-label={label}>
  <ul class="chips">
    {
      items.map((item) => (
        <li>
          <a
            class={lead ? 'chip chip-lead' : 'chip'}
            href={url(item.href)}
            aria-current={item.current ? 'page' : undefined}
          >
            {item.label}
            {typeof item.count === 'number' && <span class="count">{item.count}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
