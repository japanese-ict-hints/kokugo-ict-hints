---
import '../styles/base.css';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** トップだけ、ヘッダーのサイト名を見出しとして出さない */
  home?: boolean;
  /** 本文を読み物の幅に絞る（about・privacy など） */
  narrow?: boolean;
}

const { title, description = SITE.description, home = false, narrow = false } = Astro.props;
const pageTitle = title ? `${title}｜${SITE.title}` : SITE.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// 階層を深くしない。5つまで（2026-09-21 運営者の指示）
const navLinks = [
  { href: '/', label: 'ホーム' },
  { href: '/units/', label: '単元から探す' },
  { href: '/intents/', label: 'やりたいことから探す' },
  { href: '/tips/', label: '事例一覧' },
  { href: '/about/', label: 'このサイトについて' },
];

const footerLinks = [
  { href: '/tips/', label: '事例一覧' },
  { href: '/units/', label: '単元から探す' },
  { href: '/intents/', label: 'やりたいことから探す' },
  { href: '/regions/', label: '収集源' },
  { href: '/updates/', label: '更新履歴' },
  { href: '/about/', label: 'このサイトについて' },
  { href: '/privacy/', label: 'プライバシー' },
];

const here = Astro.url.pathname.replace(/\/+$/, '/');
const isCurrent = (href: string) => here === url(href).replace(/\/+$/, '/');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header">
      <div class="wrap header-bar">
        <a class="site-name" href={url('/')}>
          {SITE.title}
          <span class="tagline">{SITE.tagline}</span>
        </a>
        <nav class="site-nav" aria-label="サイト内">
          <ul>
            {
              navLinks.map((l) => (
                <li>
                  <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class={home ? 'is-home' : undefined}>
      <div class:list={['wrap', narrow && 'wrap-narrow']}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="フッター">
          <ul>
            {
              footerLinks.map((l) => (
                <li>
                  <a href={url(l.href)}>{l.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="disclaimer">{SITE.disclaimer}</p>
      </div>
    </footer>
  </body>
</html>
