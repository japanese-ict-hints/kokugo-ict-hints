---
import '../styles/base.css';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = SITE.description, home = false } = Astro.props;
const pageTitle = title ? `${title}｜${SITE.title}` : SITE.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const footerLinks = [
  { href: '/', label: 'トップ' },
  { href: '/regions/', label: '収集源' },
  { href: '/updates/', label: '更新履歴' },
  { href: '/about/', label: 'このサイトについて' },
  { href: '/privacy/', label: 'プライバシー' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    {
      !home && (
        <header class="site-header">
          <div class="wrap">
            <a class="site-name" href={url('/')}>
              {SITE.title}
            </a>
            <span class="tagline">{SITE.tagline}</span>
          </div>
        </header>
      )
    }

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="サイト内">
          <ul>
            {
              footerLinks.map((l) => (
                <li>
                  <a href={url(l.href)}>{l.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="disclaimer">{SITE.disclaimer}</p>
      </div>
    </footer>
  </body>
</html>
