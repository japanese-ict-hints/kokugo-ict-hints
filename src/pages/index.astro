---
import Base from '../layouts/Base.astro';
import TipList from '../components/TipList.astro';
import { loadTips, lastUpdated } from '../lib/tips';
import { url, formatDate } from '../lib/site';
import { INTENTS, tipsForIntent } from '../lib/intents';
import { KYOIKU_UNITS } from '../lib/kyoiku-units';
import { GRADE_IDS, GRADES, matchesGrade } from '../lib/grades';
import {
  DOMAIN_IDS, DOMAINS, SCENE_IDS, SCENES,
  SCHOOL_IDS, SCHOOLS, TOOL_IDS, TOOLS,
} from '../lib/vocab';

const tips = await loadTips();
const updated = lastUpdated(tips);
const recent = tips.slice(0, 6);

const unitCount = new Set(
  tips.filter((t) => t.data.unit && KYOIKU_UNITS.has(t.data.unit)).map((t) => t.data.unit),
).size;

// 0件の入口は出さない。押しても何も出ない場所を作らない
const intentItems = INTENTS.map((i) => ({ ...i, count: tipsForIntent(i, tips).length })).filter(
  (i) => i.count > 0,
);

const countBy = (key: 'scenes' | 'domains' | 'tools' | 'school', id: string) =>
  tips.filter((t) => (t.data[key] as readonly string[]).includes(id)).length;

const facets = [
  {
    name: '校種',
    items: SCHOOL_IDS.map((id) => ({ href: `/school/${id}/`, label: SCHOOLS[id], count: countBy('school', id) })),
  },
  {
    name: '学年',
    items: GRADE_IDS.map((id) => ({
      href: `/grades/${id}/`,
      label: GRADES[id].short,
      count: tips.filter((t) => matchesGrade(t.data.grade, id)).length,
    })),
  },
  {
    name: '領域',
    items: DOMAIN_IDS.map((id) => ({ href: `/domains/${id}/`, label: DOMAINS[id].short, count: countBy('domains', id) })),
  },
  {
    name: '学習場面',
    items: SCENE_IDS.map((id) => ({ href: `/scenes/${id}/`, label: SCENES[id].label, count: countBy('scenes', id) })),
  },
  {
    name: '使うツール',
    items: TOOL_IDS.map((id) => ({ href: `/tools/${id}/`, label: TOOLS[id], count: countBy('tools', id) })),
  },
].map((g) => ({ ...g, items: g.items.filter((i) => i.count > 0).sort((a, b) => b.count - a.count) }));
---

<Base home={true}>
  <section class="hero">
    <h1>国語科の授業に、ICTのひと工夫。</h1>
    <p class="hero-lead">
      明日の授業で使えるICT活用のヒントを、教材名・やりたいことから探せます。{tips.length}件。
    </p>

    <div class="big-search">
      <form action={url('/tips/')} method="get" role="search">
        <label class="sr-only" for="q">教材名・やりたいことを検索</label>
        <input
          type="search"
          id="q"
          name="q"
          autocomplete="off"
          placeholder="ごんぎつね、音読、話し合い…"
        />
        <button class="button" type="submit">検索</button>
      </form>
      <p class="hint">教材名・単元名・使い方・ツール名のどれでも探せます。</p>
    </div>
  </section>

  <ul class="entries">
    <li>
      <a class="entry" href={url('/units/')}>
        <strong>単元から探す</strong>
        <span>教科書（教育出版）の単元名・教材名から。{unitCount}の単元</span>
      </a>
    </li>
    <li>
      <a class="entry" href={url('/intents/')}>
        <strong>やりたいことから探す</strong>
        <span>「考えを共有したい」「音読を振り返らせたい」など、授業でさせたいことから</span>
      </a>
    </li>
  </ul>

  <section class="section" aria-labelledby="h-intent">
    <h2 id="h-intent">授業でこんなことをさせたい</h2>
    <ul class="chips">
      {
        intentItems.slice(0, 8).map((i) => (
          <li>
            <a class="chip" href={url(`/intents/${i.id}/`)}>
              {i.label}
              <span class="count">{i.count}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="chip" href={url('/intents/')}>すべて見る</a>
      </li>
    </ul>
  </section>

  <details class="filters">
    <summary>校種・学年・領域・場面・ツールから絞り込む</summary>
    <div class="filter-body">
      {
        facets.map((g) => (
          <div class="filter-group">
            <p>{g.name}</p>
            <ul class="chips">
              {g.items.map((i) => (
                <li>
                  <a class="chip" href={url(i.href)}>
                    {i.label}
                    <span class="count">{i.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </details>

  <section class="section" aria-labelledby="h-recent">
    <h2 id="h-recent">最近追加した事例</h2>
    <TipList tips={recent} id="recent-list" />
    <p class="lede" style="margin-top: 1rem;">
      <a class="chip chip-lead" href={url('/tips/')}>事例をすべて見る（{tips.length}件）</a>
    </p>
  </section>

  {updated && <p class="lede">最終更新 {formatDate(updated)}　<a href={url('/updates/')}>更新履歴</a></p>}
</Base>
