---
import Base from '../../layouts/Base.astro';
import Chips from '../../components/Chips.astro';
import TipList from '../../components/TipList.astro';
import { loadTips, type Tip } from '../../lib/tips';
import { url } from '../../lib/site';
import { SCHOOL_IDS, SCHOOLS, SCENE_IDS, SCENES, type SchoolId } from '../../lib/vocab';

export async function getStaticPaths() {
  const tips = await loadTips();
  return SCHOOL_IDS.map((school) => ({
    params: { school },
    props: { school, tips: tips.filter((t) => (t.data.school as readonly string[]).includes(school)) },
  }));
}

interface Props {
  school: SchoolId;
  tips: Tip[];
}

const { school, tips } = Astro.props;
const all = await loadTips();

const schoolItems = SCHOOL_IDS.map((id) => ({
  href: `/school/${id}/`,
  label: SCHOOLS[id],
  count: all.filter((t) => (t.data.school as readonly string[]).includes(id)).length,
  current: id === school,
}));

// この校種の中で、どの場面に事例があるか。件数と行き先をそろえるため、
// 飛び先は校種で絞った組み合わせページにする。
const sceneItems = SCENE_IDS.map((id) => ({
  href: `/school/${school}/scenes/${id}/`,
  label: SCENES[id].label,
  count: tips.filter((t) => (t.data.scenes as readonly string[]).includes(id)).length,
})).filter((i) => i.count > 0);
---

<Base title={SCHOOLS[school]} description={`${SCHOOLS[school]}の国語で使えるICT活用事例。`}>
  <p class="breadcrumb"><a href={url('/')}>トップ</a>　校種から探す</p>
  <h1>{SCHOOLS[school]}の国語</h1>
  <p class="lede">{tips.length}件</p>

  <section class="section" aria-labelledby="h-school">
    <h2 id="h-school">校種</h2>
    <Chips items={schoolItems} label="校種から探す" lead={true} />
  </section>

  <section class="section" aria-labelledby="h-scene">
    <h2 id="h-scene">場面で絞る</h2>
    <Chips items={sceneItems} label="場面から探す" />
  </section>

  {
    tips.length > 0 ? (
      <TipList tips={tips} />
    ) : (
      <p class="empty">この校種の事例はまだありません。</p>
    )
  }
</Base>
