---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TipList from '../../components/TipList.astro';
import { loadTips, type Tip } from '../../lib/tips';
import { url } from '../../lib/site';
import { INTENTS, tipsForIntent, type Intent } from '../../lib/intents';

export async function getStaticPaths() {
  const tips = await loadTips();
  return INTENTS.map((intent) => ({
    params: { intent: intent.id },
    props: { intent, tips: tipsForIntent(intent, tips) },
  }));
}

interface Props {
  intent: Intent;
  tips: Tip[];
}

const { intent, tips } = Astro.props;
const others = INTENTS.filter((i) => i.id !== intent.id);
---

<Base title={intent.label} description={`${intent.label}ときに使える国語のICT活用事例。${tips.length}件。`}>
  <Breadcrumb items={[{ href: '/intents/', label: 'やりたいことから探す' }, { label: intent.label }]} />
  <h1>{intent.label}</h1>
  <p class="result-count"><span class="num">{tips.length}</span>件</p>
  <p class="lede">{intent.basis}を集めています。</p>

  {
    tips.length > 0 ? (
      <>
        <h2 class="sr-only">事例</h2>
        <TipList tips={tips} id="intent-list" />
      </>
    ) : (
      <div class="empty">
        <p>この条件に当てはまる事例はまだありません。</p>
      </div>
    )
  }

  <section class="section" style="margin-top:2.4rem;" aria-labelledby="h-other">
    <h2 id="h-other">ほかのやりたいこと</h2>
    <ul class="chips">
      {
        others.map((i) => (
          <li>
            <a class="chip" href={url(`/intents/${i.id}/`)}>{i.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
