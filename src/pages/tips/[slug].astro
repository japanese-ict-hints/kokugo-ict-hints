---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TipList from '../../components/TipList.astro';
import SceneFlow from '../../components/SceneFlow.astro';
import { loadTips, relatedTips, type Tip } from '../../lib/tips';
import { HELPFUL, url, formatDate } from '../../lib/site';
import { CURRICULUM } from '../../lib/curriculum';
import { GRADE_IDS, GRADES, matchesGrade } from '../../lib/grades';
import {
  DOMAINS,
  SCENES,
  SCHOOLS,
  TOOLS,
  SUBJECTS,
  EFFORTS,
  LICENSES,
  domainColor,
} from '../../lib/vocab';

export async function getStaticPaths() {
  const tips = await loadTips();
  return tips.map((tip) => ({ params: { slug: tip.id }, props: { tip } }));
}

interface Props {
  tip: Tip;
}

const { tip } = Astro.props;
const d = tip.data;
const all = await loadTips();
const related = relatedTips(tip, all);
const { Content } = await render(tip);

const effort = EFFORTS[d.effort]!;
const color = domainColor(d.domains);
const domainLabel = d.domains.map((id) => DOMAINS[id].short).join('、');

// gov-open で本文を翻案した場合の出典表記（CLAUDE.md §7.4）。
const attribution =
  d.origin !== 'original' && d.source.license === 'gov-open'
    ? `出典：「${d.source.publisher}」（${d.source.url}）（${formatDate(d.source.retrieved)}に利用）を加工して作成`
    : null;
---

<Base title={d.unit ? `${d.unit}　${d.title}` : d.title} description={d.summary}>
  <p class="breadcrumb"><a href={url('/')}>トップ</a>　事例</p>

  <article
    data-pagefind-body
    data-pagefind-meta={`publisher:${d.source.publisher},effort:${effort.label},domain:${domainLabel},color:${color}`}
  >
    <header class="tip-header" style={`--row-accent: ${color}`}>
      <h1>
        {d.unit && <span class="tip-unit">{d.unit}</span>}
        {d.title}
      </h1>
      <p class="tip-meta">
        <span>{d.school.map((s) => SCHOOLS[s]).join('・')}</span>
        <span>{d.subjects.map((s) => SUBJECTS[s]).join('・')}</span>
        <span>準備 {effort.label}</span>
        {d.origin === 'original' && <span class="flag flag-original">自作</span>}
        {d.source.verified === 'listed' && <span class="flag">本文未確認</span>}
        {d.status === 'draft' && <span class="flag">下書き</span>}
      </p>
    </header>

    <p class="prose">{d.summary}</p>

    {
      (d.ict_use || d.ict_effect) && (
        <div class="ict">
          <h2 class="h-sub">ICTの使いどころ</h2>
          <dl class="ict-dl">
            {d.tools.length > 0 && (
              <>
                <dt>使うもの</dt>
                <dd class="ict-tools">
                  {d.tools.map((t, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={url(`/tools/${t}/`)}>{TOOLS[t]}</a>
                    </>
                  ))}
                </dd>
              </>
            )}
            {d.ict_use && (
              <>
                <dt>どこで使うか</dt>
                <dd>{d.ict_use}</dd>
              </>
            )}
            {d.ict_effect && (
              <>
                <dt>何が変わるか</dt>
                <dd>{d.ict_effect}</dd>
              </>
            )}
          </dl>
        </div>
      )
    }

    {
      d.scenes.length > 0 && (
        <>
          <h2 class="h-sub">使う場面</h2>
          <SceneFlow scenes={d.scenes} />
        </>
      )
    }

    {
      d.howto.length > 0 && (
        <>
          <h2 class="h-sub">使い方</h2>
          <ol class="howto">
            {d.howto.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </>
      )
    }

    {
      d.source.verified === 'listed' && (
        <aside class="notice">
          <p>この事例は、出典ページの見出しと抜粋だけを見て書いています。本文をまだ確認していないため、細部が実際と異なる場合があります。使う前に出典を開いて確かめてください。</p>
        </aside>
      )
    }

    {
      d.origin === 'original' ? (
        <aside class="notice notice-original">
          <p>
            <strong>この事例は、このサイトが考えたものです。</strong>
            どこかの学校で実際に行われた記録ではありません。学習指導要領の内容と、
            ほかの事例で確かめられた進め方をもとに組み立てています。試すときは、
            目の前の子どもに合うかどうかをご自分で判断してください。
          </p>
        </aside>
      ) : (
        <>
          <p>
            <a class="button" href={d.source.url} rel="noopener nofollow" target="_blank">
              出典を開く（外部サイト）
            </a>
          </p>
          <p class="button-note">{d.source.publisher}　{d.source.url}</p>
        </>
      )
    }

    <h2 class="h-sub">この事例の見どころ</h2>
    <div class="prose">
      <Content />
    </div>


    {
      d.note && (
        <aside class="notice">
          <p>{d.note}</p>
        </aside>
      )
    }

    <aside class="helpful" hidden id="helpful" data-slug={tip.id} data-count-url={HELPFUL.countUrl}>
      <p class="helpful-label">{HELPFUL.label}</p>
      <button type="button" class="button button-quiet" id="helpful-button">
        {HELPFUL.button}
      </button>
      <p class="helpful-count" id="helpful-count" role="status" aria-live="polite"></p>
    </aside>

    <h2 class="h-sub">この事例の情報</h2>
    <dl class="meta-table">
      <div>
        <dt>{d.origin === 'original' ? '作成' : '出典'}</dt>
        <dd>{d.origin === 'original' ? 'このサイト（自作）' : `${d.source.publisher}（${d.source.region}）`}</dd>
      </div>
      {
        d.source.published && (
          <div>
            <dt>公開日</dt>
            <dd>{formatDate(d.source.published)}</dd>
          </div>
        )
      }
      <div>
        <dt>取得日</dt>
        <dd>{formatDate(d.source.retrieved)}</dd>
      </div>
      <div>
        <dt>扱い</dt>
        <dd>{LICENSES[d.source.license]}</dd>
      </div>
      {
        d.unit && (
          <div>
            <dt>単元</dt>
            <dd>
              <a href={url('/units/')}>{d.unit}</a>
            </dd>
          </div>
        )
      }
      {
        d.grade && (
          <div>
            <dt>学年</dt>
            <dd>
              {GRADE_IDS.filter((g) => matchesGrade(d.grade, g)).length > 0
                ? GRADE_IDS.filter((g) => matchesGrade(d.grade, g)).map((g, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={url(`/grades/${g}/`)}>{GRADES[g].short}</a>
                    </>
                  ))
                : d.grade}
            </dd>
          </div>
        )
      }
      {
        d.domains.length > 0 && (
          <div>
            <dt>領域</dt>
            <dd>
              {d.domains.map((id, i) => (<>{i > 0 && '、'}<a href={url(`/domains/${id}/`)} data-pagefind-filter="領域">{DOMAINS[id].label}</a></>))}
            </dd>
          </div>
        )
      }
      {
        d.scenes.length > 0 && (
          <div>
            <dt>場面</dt>
            <dd>
              {d.scenes.map((id, i) => (<>{i > 0 && '、'}<a href={url(`/scenes/${id}/`)} data-pagefind-filter="場面">{SCENES[id].label}</a></>))}
            </dd>
          </div>
        )
      }
      {
        d.tools.length > 0 && (
          <div>
            <dt>ツール</dt>
            <dd>
              {d.tools.map((id, i) => (<>{i > 0 && '、'}<a href={url(`/tools/${id}/`)} data-pagefind-filter="ツール">{TOOLS[id]}</a></>))}
            </dd>
          </div>
        )
      }
      <div>
        <dt>校種</dt>
        <dd>
          {d.school.map((id, i) => (<>{i > 0 && '、'}<a href={url(`/school/${id}/`)} data-pagefind-filter="校種">{SCHOOLS[id]}</a></>))}
        </dd>
      </div>
      {
        d.curriculum.length > 0 && (
          <div>
            <dt>学習指導要領</dt>
            <dd>
              {d.curriculum
                .map((code) =>
                  CURRICULUM[code]
                    ? `${CURRICULUM[code].school} ${CURRICULUM[code].segmentLabel} ${CURRICULUM[code].label}`
                    : code,
                )
                .join('、')}
              <span class="code-note">サイト側で領域まで当てたもの</span>
            </dd>
          </div>
        )
      }
      <div>
        <dt>掲載日</dt>
        <dd>{formatDate(d.added)}</dd>
      </div>
    </dl>

    {attribution && <p class="attribution">{attribution}</p>}

  </article>

<script is:inline>
  // 「役に立った」。押した数は受け口（HELPFUL.countUrl）で数える。
  // 受け口が未設定なら、押した記録は端末の中だけに残り、数は出さない。
  // JSが無い環境ではボタン自体を出さない（押せないボタンを置かない）。
  (function () {
    var box = document.getElementById('helpful');
    var btn = document.getElementById('helpful-button');
    var out = document.getElementById('helpful-count');
    if (!box || !btn || !out) return;

    var slug = box.getAttribute('data-slug') || '';
    var countUrl = box.getAttribute('data-count-url') || '';
    var key = 'helpful:' + slug;

    function pressed() {
      try {
        return window.localStorage.getItem(key) === '1';
      } catch (e) {
        return false;
      }
    }
    function remember() {
      try {
        window.localStorage.setItem(key, '1');
      } catch (e) {
        /* 保存できない設定でも動きは変えない */
      }
    }
    function showCount(n) {
      if (typeof n !== 'number' || !isFinite(n) || n < 0) return;
      out.textContent = n === 0 ? 'まだ押されていません' : n + '人が役に立ったと答えています';
    }
    function markPressed() {
      btn.disabled = true;
      btn.setAttribute('aria-pressed', 'true');
      btn.textContent = '\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f';
    }

    box.hidden = false;
    if (pressed()) markPressed();

    if (countUrl) {
      fetch(countUrl + '?slug=' + encodeURIComponent(slug), { method: 'GET' })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (d) showCount(d.count);
        })
        .catch(function () {
          /* 数が取れなくてもボタンは使える */
        });
    }

    btn.addEventListener('click', function () {
      remember();
      markPressed();
      if (!countUrl) return;
      fetch(countUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug: slug }),
      })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (d) showCount(d.count);
        })
        .catch(function () {
          /* 送れなくても表示は変えない */
        });
    });
  })();
</script>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="h-related" data-pagefind-ignore>
        <h2 id="h-related">近い事例</h2>
        <TipList tips={related} id="related-list" />
      </section>
    )
  }
</Base>
