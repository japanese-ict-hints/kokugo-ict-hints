---
import Base from '../../layouts/Base.astro';
import TipList from '../../components/TipList.astro';
import { loadTips } from '../../lib/tips';
import { url, formatDate, formatISO } from '../../lib/site';

const tips = await loadTips();

const groups = new Map<string, typeof tips>();
for (const t of tips) {
  const key = formatISO(t.data.added);
  groups.set(key, [...(groups.get(key) ?? []), t]);
}
const days = [...groups.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1));
---

<Base title="更新履歴" description="事例を追加した日ごとの一覧。">
  <p class="breadcrumb"><a href={url('/')}>トップ</a>　更新履歴</p>
  <h1>更新履歴</h1>
  <p class="lede">追加した日ごとに並べています。</p>

  {
    days.map(([day, items]) => (
      <section class="section">
        <h2>
          {formatDate(items[0]!.data.added)}　{items.length}件
        </h2>
        <TipList tips={items} id={`day-${day}`} />
      </section>
    ))
  }
</Base>
